diff --git a/unittest/TestShaderGenerators.cpp b/unittest/TestShaderGenerators.cpp
index 2137fbda..a2eeb032 100644
--- a/unittest/TestShaderGenerators.cpp
+++ b/unittest/TestShaderGenerators.cpp
@@ -505,6 +505,42 @@ bool TestFragmentShaders() {
 	return true;
 }
 
+// Modified by RetroPlay: GE_TEXLEVEL_MODE_SLOPE textures sample at an explicit LOD from w.
+bool TestTexLodSlopeShaders() {
+	char *buffer = new char[65536];
+	Draw::Bugs bugs;
+	bool ok = true;
+	for (bool proj : { false, true }) {
+		FShaderID id;
+		id.SetBit(FS_BIT_DO_TEXTURE);
+		id.SetBits(FS_BIT_TEXFUNC, 3, GE_TEXFUNC_MODULATE);
+		id.SetBit(FS_BIT_DO_TEXTURE_PROJ, proj);
+		id.SetBit(FS_BIT_TEX_LOD_SLOPE);
+		const char *expected = proj ? "textureProjLod(tex" : "textureLod(tex";
+		for (ShaderLanguage lang : { ShaderLanguage::GLSL_VULKAN, ShaderLanguage::GLSL_3xx, ShaderLanguage::GLSL_1xx }) {
+			std::string genError;
+			if (!GenerateFShader(id, buffer, lang, bugs, &genError)) {
+				printf("TexLodSlope: %s failed to generate: %s\n", ShaderLanguageToString(lang), genError.c_str());
+				ok = false;
+				continue;
+			}
+			const bool hasLod = strstr(buffer, expected) != nullptr && strstr(buffer, "log2(gl_FragCoord.w)") != nullptr;
+			// GLSL 1.10 has no textureLod in fragment shaders, so it keeps the hardware LOD.
+			if (hasLod != (lang != ShaderLanguage::GLSL_1xx)) {
+				printf("TexLodSlope: %s %s %s:\n%s\n", ShaderLanguageToString(lang), hasLod ? "unexpectedly uses" : "lacks", expected, LineNumberString(buffer).c_str());
+				ok = false;
+			}
+			std::string errorMessage;
+			if (!TestCompileShader(buffer, lang, ShaderStage::Fragment, &errorMessage)) {
+				printf("TexLodSlope: %s doesn't compile:\n%s\n%s\n", ShaderLanguageToString(lang), LineNumberString(buffer).c_str(), errorMessage.c_str());
+				ok = false;
+			}
+		}
+	}
+	delete[] buffer;
+	return ok;
+}
+
 bool TestShaderGenerators() {
 #if PPSSPP_PLATFORM(WINDOWS)
 	LoadD3D11();
@@ -529,6 +565,10 @@ bool TestShaderGenerators() {
 		return false;
 	}
 
+	if (!TestTexLodSlopeShaders()) {
+		return false;
+	}
+
 	if (!TestVertexShaders()) {
 		return false;
