{
  "keep": [
    "build/dd-land"
  ],
  "workspaces": 1,
  "checks": [
    {
      "name": "package",
      "run": "s=$(xcrun simctl list devices | grep -F 'RetroPlay Build (' | grep -oE '[0-9A-F-]{36}' | head -1); [ -n \"$s\" ] || { echo 'No RetroPlay Build Simulator'; exit 1; }; xcrun simctl boot \"$s\" 2>/dev/null; xcrun simctl bootstatus \"$s\" >/dev/null && cd App && xcodebuild test -scheme RetroPlay-Package -destination id=$s -derivedDataPath ../build/dd-land/package -collect-test-diagnostics never -quiet; r=$?; xcrun simctl shutdown $s 2>/dev/null; exit $r",
      "inputs": [
        "App/Package.swift",
        "App/Sources/**",
        "App/Tests/**",
        "!**/*.md"
      ],
      "line": "sim-retroplay",
      "timeout": 40
    },
    {
      "name": "app",
      "run": "Scripts/app-tests.sh",
      "inputs": [
        "AppHost/**",
        "AppIcon.icon/**",
        "App/Sources/**",
        "App/Tests/**",
        "App/Package.swift",
        "project.yml",
        "Scripts/app-tests.sh",
        "!**/*.md"
      ],
      "key": "cd \"$LAND_SOURCE\" && { for f in App/Vendor/Output/*.xcframework; do echo \"$f $(stat -f %m \"$f/Info.plist\")\"; done; for x in External/*; do echo \"$x $(git -C \"$x\" rev-parse HEAD 2>/dev/null)\"; done; } | shasum",
      "line": "sim-retroplay",
      "timeout": 75,
      "select": {
        "env": "APP_TESTS",
        "always": [
          "LibraryTopBarUITests"
        ],
        "rules": [
          {
            "paths": [
              "App/Sources/RetroPlayApp/Library/**",
              "App/Sources/RetroPlayApp/AppEntry.swift"
            ],
            "tests": [
              "LibraryTopBarUITests",
              "CoverFlowTapUITests",
              "TypographyScreenshotsUITests"
            ]
          },
          {
            "paths": [
              "App/Sources/RetroPlayApp/Theme/**",
              "App/Sources/RetroPlayCore/TypeScale.swift",
              "AppHost/Supporting/**"
            ],
            "tests": [
              "TypographyScreenshotsUITests"
            ]
          },
          {
            "paths": [
              "App/Sources/RetroPlayApp/PlayView.swift",
              "App/Sources/RetroPlayApp/PlayMenuView.swift",
              "App/Sources/RetroPlayApp/Controls/**"
            ],
            "tests": [
              "TypographyScreenshotsUITests"
            ]
          },
          {
            "paths": [
              "App/Sources/RetroPlayCore/LibrarySaveImport.swift",
              "App/Sources/RetroPlayCore/SaveGameImporter.swift",
              "App/Sources/RetroPlayApp/Library/SaveImportSheet.swift"
            ],
            "tests": [
              "LibraryTopBarUITests",
              "FilesPickerSaveImportUITests",
              "SaveImportSMBUITests"
            ]
          }
        ]
      }
    }
  ],
  "release": {
    "run": "ln -sfn \"$INTEGRATE_SOURCE/App/Vendor/Output\" App/Vendor/Output && ln -sfn \"$INTEGRATE_SOURCE/External\" External && mercurius-agent secret run --env ASC_KEY_ID,ASC_ISSUER_ID,ASC_KEY_P8 -- Scripts/testflight.sh",
    "inputs": [
      "**",
      "!**/*.md",
      "!docs/**",
      "!.mercurius/**"
    ],
    "line": "build",
    "timeout": 60
  }
}
