{
  "keep": [
    "build/dd-integrate"
  ],
  "workspaces": 1,
  "checks": [
    {
      "name": "app",
      "run": "Scripts/app-tests.sh",
      "inputs": [
        "AppHost/**",
        "AppIcon.icon/**",
        "App/Sources/**",
        "App/Tests/**",
        "App/Package.swift",
        "project.yml",
        "Scripts/app-tests.sh",
        "!**/*.md"
      ],
      "key": "cd \"$INTEGRATE_SOURCE\" && { for f in App/Vendor/Output/*.xcframework; do echo \"$f $(stat -f %m \"$f/Info.plist\")\"; done; for x in External/*; do echo \"$x $(git -C \"$x\" rev-parse HEAD 2>/dev/null)\"; done; } | shasum",
      "line": "sim-retroplay",
      "timeout": 120,
      "select": {
        "env": "APP_TESTS",
        "always": [
          "LibraryTopBarUITests"
        ],
        "rules": [
          {
            "paths": [
              "App/Sources/RetroPlayApp/Library/**",
              "App/Sources/RetroPlayApp/AppEntry.swift"
            ],
            "tests": [
              "LibraryTopBarUITests",
              "CoverFlowTapUITests"
            ]
          },
          {
            "paths": [
              "App/Sources/RetroPlayCore/LibrarySaveImport.swift",
              "App/Sources/RetroPlayCore/SaveGameImporter.swift",
              "App/Sources/RetroPlayCore/KeptSaves.swift",
              "App/Sources/RetroPlayApp/Library/SaveImportSheet.swift"
            ],
            "tests": [
              "LibraryTopBarUITests",
              "FilesPickerSaveImportUITests",
              "SaveImportSMBUITests"
            ]
          },
          {
            "paths": [
              "App/Sources/RetroPlayApp/SettingsView.swift",
              "App/Sources/RetroPlayApp/KeptSavesView.swift",
              "App/Sources/RetroPlayCore/KeptSaves.swift"
            ],
            "tests": [
              "SettingsKeptSavesUITests"
            ]
          },
          {
            "paths": [
              "App/Sources/RetroPlayApp/PlayView.swift",
              "App/Sources/RetroPlayApp/PlayMenuView.swift",
              "App/Sources/RetroPlayApp/Controls/**",
              "App/Sources/RetroPlayCore/Play/LandscapeCentreRow.swift"
            ],
            "tests": [
              "PauseMenuFitUITests",
              "LandscapeCentreRowUITests"
            ]
          }
        ]
      }
    },
    {
      "name": "screenshots",
      "run": "Scripts/app-tests.sh screenshots",
      "inputs": [
        "AppHost/**",
        "AppIcon.icon/**",
        "App/Sources/**",
        "App/Tests/**",
        "App/Package.swift",
        "project.yml",
        "Scripts/app-tests.sh",
        "!**/*.md"
      ],
      "key": "cd \"$INTEGRATE_SOURCE\" && { for f in App/Vendor/Output/*.xcframework; do echo \"$f $(stat -f %m \"$f/Info.plist\")\"; done; for x in External/*; do echo \"$x $(git -C \"$x\" rev-parse HEAD 2>/dev/null)\"; done; } | shasum",
      "line": "sim-retroplay",
      "timeout": 120,
      "onRequest": true
    }
  ],
  "release": {
    "run": "ln -sfn \"$INTEGRATE_SOURCE/App/Vendor/Output\" App/Vendor/Output && ln -sfn \"$INTEGRATE_SOURCE/External\" External && mercurius-agent secret run --env ASC_KEY_ID,ASC_ISSUER_ID,ASC_KEY_P8 -- Scripts/testflight.sh",
    "inputs": [
      "**",
      "!**/*.md",
      "!docs/**",
      "!.mercurius/**"
    ],
    "line": "build",
    "timeout": 60
  }
}
